{
  "name": "daily-orbit",
  "productName": "The Daily Orbit",
  "version": "1.1.0",
  "description": "Your personal daily newspaper: world, India, finance, tech, science, sports, astronomy and more, learned on your laptop",
  "main": "src/main.js",
  "author": "Vishal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "test": "node test/brain.test.js && node test/sky.test.js && node test/run.js",
    "fetch-model": "node scripts/fetch-model.js"
  },
  "build": {
    "appId": "com.vishal.dailyorbit",
    "productName": "The Daily Orbit",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/onnxruntime-node/bin/**/darwin/**",
      "!node_modules/onnxruntime-node/bin/**/linux/**",
      "!node_modules/onnxruntime-node/bin/**/win32/arm64/**",
      "!node_modules/onnxruntime-web/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "The Daily Orbit",
      "artifactName": "DailyOrbit-Setup-${version}.exe",
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "portable": {
      "artifactName": "DailyOrbit-Portable-${version}.exe"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": ">=37.0.0 <50.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}